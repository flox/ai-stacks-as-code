# --- Flox ---
# COMMIT the reproducible spec in every environment:
#   .flox/env/manifest.toml, .flox/env/manifest.lock, .flox/env.json
# The env will not resolve without env.json / the lock, so nothing under
# .flox/env/ (and no *.json) is ignored. Only per-activation runtime state is:
**/.flox/run/
**/.flox/cache/

# --- Generated pipeline outputs ---
work/
reports/

# --- flox build artifacts + model cache ---
result-*
.hfcache/

# --- ask-flox-demo: the store-path-pinned test env is machine-specific
# (its lock references a local /nix/store hash). Keep only the portable
# manifest.toml.template; the realised env is created post-publish.
envs/ask-flox-demo/.flox/

# --- Python ---
__pycache__/
*.py[cod]

# --- OS / editor cruft ---
.DS_Store
*.swp
