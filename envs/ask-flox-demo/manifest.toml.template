# Ask-Flox demo environment (TEMPLATE) --------------------------------------
#
# The "people run this" deliverable: activate it and you get Claude Code with
# the `search_flox_docs` tool already wired to the baked Flox-docs index.
#
# This is a TEMPLATE, not a locked env — it installs the published `ask-flox`
# package, which must exist first. To realise it after publishing:
#
#   1. flox publish the `ask-flox` package (from the repo root), on each arch.
#   2. mkdir -p envs/ask-flox-demo && cd envs/ask-flox-demo && flox init
#   3. Replace the generated manifest with this file, setting <catalog> below.
#   4. flox activate            # locks against the published package
#   5. flox push                # -> FloxHub; users: flox activate -r <you>/ask-flox-demo
#
# Runtime deps mirror ai-embeddings' pkg-group discipline (they cannot ride
# along inside the ask-flox package — see the [build] note in the composer).
version = 1

[install]
# The data+code package we built and published (index + model + server code).
ask-flox.pkg-path              = "<catalog>/ask-flox"

# Claude Code — the agent that will call the tool.
claude-code.pkg-path           = "flox/claude-code"

# Python runtime + retrieval deps. The default embedder is ONNX (torch-free),
# so this needs only mcp + chromadb (which brings onnxruntime) — no torch/CUDA,
# no glibc floor, no per-system torch split. Works uniformly across all systems.
python3.pkg-path               = "python3"
mcp.pkg-path                   = "python313Packages.mcp"
mcp.pkg-group                  = "mcp"
chromadb.pkg-path              = "python313Packages.chromadb"
chromadb.pkg-group             = "chromadb"

[hook]
on-activate = '''
# Put the packaged launcher on PATH (see packaging/ask-flox-mcp — stages the
# read-only index to a writable cache, forces offline, runs the stdio server).
mkdir -p "$FLOX_ENV_CACHE/bin"
install -m755 "$FLOX_ENV/share/ask-flox/ask-flox-mcp" "$FLOX_ENV_CACHE/bin/ask-flox-mcp"
export PATH="$FLOX_ENV_CACHE/bin:$PATH"

# Register the tool with Claude Code via a config file, exposed as `ask-flox`.
cat > "$FLOX_ENV_CACHE/ask-flox.mcp.json" <<EOF
{ "mcpServers": { "ask-flox": { "command": "ask-flox-mcp" } } }
EOF
'''

[profile]
common = '''
# `ask-flox` — launch Claude Code with the retrieval tool pre-registered.
'''
bash = '''
alias ask-flox='claude --mcp-config "$FLOX_ENV_CACHE/ask-flox.mcp.json"'
'''
zsh = '''
alias ask-flox='claude --mcp-config "$FLOX_ENV_CACHE/ask-flox.mcp.json"'
'''
fish = '''
alias ask-flox 'claude --mcp-config "$FLOX_ENV_CACHE/ask-flox.mcp.json"'
'''

[options]
systems = ["x86_64-linux", "aarch64-linux", "aarch64-darwin"]
